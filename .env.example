DATABASE_URL="file:./dev.db"

# Ollama-backed local RAG settings
# Typical setup:
# 1. Install Ollama
# 2. Pull models like `ollama pull qwen3:8b` and `ollama pull nomic-embed-text`
OLLAMA_BASE_URL="http://127.0.0.1:11434/v1"
OLLAMA_API_KEY=""
OLLAMA_RAG_EMBEDDING_MODEL="nomic-embed-text"
OLLAMA_RAG_RESPONSE_MODEL="qwen3:8b"

# Your name, used to sign drafted follow-up messages (optional)
APPLICANT_NAME=""

# Contact research (Tavily-compatible search API; free tier is enough)
TAVILY_API_KEY=""

# Read drafts aloud with ElevenLabs (optional; the free tier has a monthly character quota)
ELEVENLABS_API_KEY=""
# Optional overrides: any voice from your ElevenLabs voice library, and the TTS model
ELEVENLABS_VOICE_ID=""
ELEVENLABS_MODEL_ID="eleven_multilingual_v2"

# Shared secret for the Job Tracker browser extension; paste the same value into its settings
EXTENSION_TOKEN=""

# Job feed: LinkedIn, Indeed, and Google Jobs results through JSearch on RapidAPI (optional, free tier)
JSEARCH_API_KEY=""
