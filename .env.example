DATABASE_URL="file:./dev.db"

# RAG provider: "ollama" (default, free, runs locally) or "openai" (paid API)
RAG_PROVIDER="ollama"

# Ollama-backed local RAG settings
# Typical setup:
# 1. Install Ollama
# 2. Pull models like `ollama pull qwen3:8b` and `ollama pull nomic-embed-text`
OLLAMA_BASE_URL="http://127.0.0.1:11434/v1"
OLLAMA_API_KEY=""
OLLAMA_RAG_EMBEDDING_MODEL="nomic-embed-text"
OLLAMA_RAG_RESPONSE_MODEL="qwen3:8b"

# OpenAI-backed RAG settings (optional, paid; only used when RAG_PROVIDER="openai")
# Switching providers requires re-syncing application context, since embedding
# dimensions differ between models.
# OPENAI_API_KEY="your_openai_api_key"
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_RAG_EMBEDDING_MODEL="text-embedding-3-small"
# OPENAI_RAG_RESPONSE_MODEL="gpt-5.4-mini"
# OPENAI_RAG_REASONING_EFFORT="low"

# Contact research (Tavily-compatible search API; free tier is enough)
TAVILY_API_KEY=""
