generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum DocumentSourceType {
  APPLICATION_PROFILE
  APPLICATION_NOTES
  RECRUITER_CONTEXT
  JOB_POSTING
}

model Application {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company      String
  role         String
  link         String?
  stage        String   @default("applied") // applied, interview, rejected, offer
  dateApplied  String   // YYYY-MM-DD local date
  notes        String?

  reminders    Reminder[]
  recruiters   Recruiter[]
  followUps    FollowUp[]
  drafts       GeneratedDraft[]
  documents    ApplicationDocument[]
  chunks       DocumentChunk[]
}

model Recruiter {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  applicationId String

  name          String?
  title         String?
  email         String?
  linkedIn      String?
  source        String?

  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  followUps     FollowUp[]
  drafts        GeneratedDraft[]

  @@index([applicationId])
}

model FollowUp {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  applicationId String
  recruiterId   String?

  dueDate       String    // YYYY-MM-DD local date
  channel       String    @default("email") // email, linkedin, other
  status        String    @default("planned") // planned, sent, skipped
  sentAt        DateTime?
  notes         String?
  draftId       String?   // approved AI draft attached as this follow-up's message

  application   Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  recruiter     Recruiter?      @relation(fields: [recruiterId], references: [id], onDelete: SetNull)
  draft         GeneratedDraft? @relation(fields: [draftId], references: [id], onDelete: SetNull)
  reminders     Reminder[]

  @@index([applicationId])
  @@index([status, dueDate])
}

// LLM output held for human review. Nothing generated is used until it is approved.
model GeneratedDraft {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  applicationId String
  recruiterId   String?

  kind          String    // follow_up_email, qa_answer
  prompt        String
  content       String    // what the model wrote
  editedContent String?   // reviewer's edits, used instead of content when present
  citations     String    // JSON array of retrieved sources
  provider      String
  model         String
  language      String    @default("en") // en, es
  status        String    @default("pending_review") // pending_review, approved, rejected
  reviewedAt    DateTime?
  appliedAt     DateTime?

  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  recruiter     Recruiter?  @relation(fields: [recruiterId], references: [id], onDelete: SetNull)
  followUps     FollowUp[]

  @@index([applicationId, createdAt])
}

// A resume version used for keyword matching against job descriptions.
model Resume {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String
  fileName  String?
  text      String
  isDefault Boolean  @default(false)
}

model DailyGoal {
  id          String @id @default(cuid())
  date        String @unique // YYYY-MM-DD
  targetCount Int    @default(5)
}

model DailyNote {
  id   String @id @default(cuid())
  date String @unique // YYYY-MM-DD
  text String @default("")
}

model Reminder {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  date      String   // YYYY-MM-DD
  time      String   // HH:MM (24h)
  message   String
  done      Boolean  @default(false)

  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  followUpId    String?
  followUp      FollowUp?    @relation(fields: [followUpId], references: [id], onDelete: Cascade)
}

model ApplicationDocument {
  id           String             @id @default(cuid())
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  applicationId String
  sourceType   DocumentSourceType
  title        String
  url          String?
  content      String
  lastSyncedAt DateTime           @default(now())

  application  Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  chunks       DocumentChunk[]

  @@unique([applicationId, sourceType])
}

model DocumentChunk {
  id          String              @id @default(cuid())
  createdAt   DateTime            @default(now())
  documentId  String
  applicationId String
  chunkIndex  Int
  content     String
  embedding   String

  document    ApplicationDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  application Application         @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([applicationId])
}
