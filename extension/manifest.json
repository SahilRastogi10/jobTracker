{
  "manifest_version": 3,
  "name": "Job Tracker Capture",
  "version": "1.0.0",
  "description": "Saves job applications to your local Job Tracker as you apply.",
  "permissions": ["storage", "activeTab", "scripting", "alarms"],
  "host_permissions": ["http://localhost:3000/*", "http://127.0.0.1:3000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Job Tracker",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://www.linkedin.com/jobs/*"
      ],
      "js": ["extract.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
